# LLM
GEMINI_API_KEY=paste-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# LLM provider: "gemini" (default, quota-limited cloud API) or "ollama"
# (local, unlimited calls - no daily quota gating applies to it).
LLM_PROVIDER=gemini
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_PRO=llama3
# OLLAMA_MODEL_FLASH=llama3
# OLLAMA_MODEL_LITE=llama3
# OLLAMA_EMBED_MODEL=nomic-embed-text

# NCBI
NCBI_EMAIL=paste-your-email-here
NCBI_API_KEY=paste-your-ncbi-api-key-here

# General
LOG_LEVEL=INFO
MAX_WORKER_SECONDS=10
MAX_WORKER_MEMORY_MB=256